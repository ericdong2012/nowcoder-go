# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo

# ===== Python =====
# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class

# 打包 / 分发
build/
dist/
*.egg
*.egg-info/

# 测试 / 覆盖率 / 类型检查缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# 虚拟环境
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# ===== Go =====
