*.exe
*.exe~
*.dll
*.dylib

# go test -c 的测试二进制
*.test

# 覆盖率 / 性能分析产物
*.out
*.prof
coverage/

# 依赖目录
vendor/

# Go workspace 文件
go.work
go.work.sum

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

